# Frontend env. Copy to .env and fill in. Never commit .env.
# The frontend holds NO secrets: database, Cloudinary and Razorpay credentials live only in the backend.

# Spring Boot backend (server-side only; the browser reaches it through the same-origin /api proxy)
BACKEND_URL=http://localhost:2420

# Public site URL (metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Business details shown in the footer and invoices (GSTIN/address hidden until set)
NEXT_PUBLIC_BUSINESS_NAME="VIRO eco"
NEXT_PUBLIC_BUSINESS_EMAIL=info@viroeco.com
NEXT_PUBLIC_BUSINESS_PHONE=
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_BUSINESS_GSTIN=
